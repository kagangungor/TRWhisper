<Window x:Class="TRWhisper.UI.PillOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRWhisper Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Waveform Animasyonları -->
        <Storyboard x:Key="WaveAnim" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height"
                             From="6" To="20" Duration="0:0:0.35" />
            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height"
                             From="10" To="26" Duration="0:0:0.42" BeginTime="0:0:0.08" />
            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height"
                             From="16" To="30" Duration="0:0:0.38" BeginTime="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height"
                             From="10" To="24" Duration="0:0:0.45" BeginTime="0:0:0.05" />
            <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height"
                             From="6" To="18" Duration="0:0:0.32" BeginTime="0:0:0.12" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Ana Kapsül (Pill) -->
        <Border x:Name="PillBorder"
                Background="#161618"
                BorderBrush="#2D2D32"
                BorderThickness="1"
                CornerRadius="26"
                Padding="8"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <!-- 1. MOD: DİNLENİYOR / ÇÖZÜMLENİYOR (LISTENING / PROCESSING) -->
                <Grid x:Name="ListeningPanel" Height="36" Margin="4,0,4,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Kapat/İptal Düğmesi (Görseldeki gibi koyu gri daire içinde X) -->
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Width="32" Height="32"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#26262B" CornerRadius="16">
                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 2,2 L 14,14 M 14,2 L 2,14"
                                              Stroke="#A0A0AB" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#383842" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Orta: Ses Dalgaları (Waveform) ve "Listening" Yazısı -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,0,20,0">

                        <!-- Dalga Çubukları -->
                        <StackPanel x:Name="WaveBarsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Height="32">
                            <Rectangle x:Name="Bar1" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#D4D4D8" Margin="1.5,0" VerticalAlignment="Center" />
                            <Rectangle x:Name="Bar2" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="#E4E4E7" Margin="1.5,0" VerticalAlignment="Center" />
                            <Rectangle x:Name="Bar3" Width="3" Height="24" RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF" Margin="1.5,0" VerticalAlignment="Center" />
                            <Rectangle x:Name="Bar4" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#E4E4E7" Margin="1.5,0" VerticalAlignment="Center" />
                            <Rectangle x:Name="Bar5" Width="3" Height="8"  RadiusX="1.5" RadiusY="1.5" Fill="#D4D4D8" Margin="1.5,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Durum Metni -->
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Dinleniyor"
                                   Foreground="#CCCCCC"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Sağ: Tamamla Düğmesi (Görseldeki gibi beyaz daire içinde siyah tik) -->
                    <Button x:Name="FinishButton"
                            Grid.Column="2"
                            Width="32" Height="32"
                            Cursor="Hand"
                            Click="FinishButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="chkBorder" Background="#FFFFFF" CornerRadius="16">
                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 3.5,8.5 L 7,12 L 13.5,5"
                                              Stroke="#161618" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="chkBorder" Property="Background" Value="#E4E4E7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 2. MOD: TRANSKRİPT SONUCU VE KOPYALAMA (RESULT & COPY PANEL) -->
                <Grid x:Name="ResultPanel" Visibility="Collapsed" MinWidth="340" MaxWidth="560">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Transkript Metni -->
                    <ScrollViewer Grid.Row="0"
                                  MaxHeight="140"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="8,4,8,8">
                        <TextBlock x:Name="TranscriptTextBlock"
                                   Text="Transkript buraya gelecek..."
                                   TextWrapping="Wrap"
                                   Foreground="#F4F4F5"
                                   FontSize="14"
                                   LineHeight="20"
                                   FontWeight="Normal" />
                    </ScrollViewer>

                    <!-- Alt Butonlar -->
                    <Grid Grid.Row="1" Margin="8,4,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ResultInfoText"
                                   Grid.Column="0"
                                   Text="Panoya otomatik kopyalandı"
                                   Foreground="#71717A"
                                   FontSize="12"
                                   VerticalAlignment="Center" />

                        <!-- Kopyala Butonu -->
                        <Button x:Name="CopyButton"
                                Grid.Column="1"
                                Height="30"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Click="CopyButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBrd" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="15">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock x:Name="CopyIcon" Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="CopyText" Text="Kopyala" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBrd" Property="Background" Value="#3F3F46" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Kapat Butonu -->
                        <Button x:Name="CloseResultButton"
                                Grid.Column="2"
                                Width="30" Height="30"
                                Cursor="Hand"
                                Click="CloseResultButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="clsBrd" Background="#27272A" CornerRadius="15">
                                        <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 2,2 L 14,14 M 14,2 L 2,14"
                                                  Stroke="#A1A1AA" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="clsBrd" Property="Background" Value="#3F3F46" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
