        <Style x:Key="ScrollTroughButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTroughButton}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTroughButton}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="#3A3A42" CornerRadius="3" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="#4E4E58" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="#62626E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ================================ YERLEŞİM ================================ -->
    <Border x:Name="WindowBorder"
            Background="#0F0F11"
            BorderBrush="{StaticResource Stroke}"
            BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol gezinme -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,16,20,16" Background="Transparent">
                        <TextBlock Text="TRWhisper" Foreground="{StaticResource TextPrimary}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Ayarlar" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavGeneral"    Style="{StaticResource NavButton}" Content="Genel"       IsChecked="True" Checked="Nav_Checked" Tag="0" />
                        <RadioButton x:Name="NavAudio"      Style="{StaticResource NavButton}" Content="Ses"         Checked="Nav_Checked" Tag="1" />
                        <RadioButton x:Name="NavModel"      Style="{StaticResource NavButton}" Content="Model ve Yapay Zeka" Checked="Nav_Checked" Tag="2" />
                        <RadioButton x:Name="NavHotkey"     Style="{StaticResource NavButton}" Content="Kısayol"     Checked="Nav_Checked" Tag="3" />
                        <RadioButton x:Name="NavDictionary" Style="{StaticResource NavButton}" Content="Sözlük"      Checked="Nav_Checked" Tag="4" />
                        <RadioButton x:Name="NavOverlay"    Style="{StaticResource NavButton}" Content="Kapsül"      Checked="Nav_Checked" Tag="6" />
                        <RadioButton x:Name="NavBackup"     Style="{StaticResource NavButton}" Content="Yedekleme ve Geçmiş" Checked="Nav_Checked" Tag="7" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sağ panel (Üstte pencere butonları + altta ayar sayfaları) -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Şeffaf başlık & pencere kontrol butonları -->
                <Grid Grid.Row="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Click="MinimizeButton_Click" ToolTip="Simge durumuna küçült">
                            <Path Data="{StaticResource IconMinimize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="10" Height="10" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Click="MaximizeButton_Click" ToolTip="Ekranı kapla">
                            <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1" Width="10" Height="10" SnapsToDevicePixels="True" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                                Click="CloseButton_Click" ToolTip="Kapat">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="10" Height="10" SnapsToDevicePixels="True" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sağ içerik -->
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Padding="28,10,28,16">
                    <StackPanel x:Name="PanelHost">

                <!-- Birleşik menü öğelerinde iki alt sayfa arasında geçiş -->
                <Border x:Name="SubNavBar" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,2,0,12"
                        Background="#17171A" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="8" Padding="3">
                    <!-- Eşit genişlik: kısa etiket ("Geçmiş") uzun olanın ("Yedekleme") yanında sıkışmaz. -->
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="SubNavFirst" Style="{StaticResource SegmentButton}" Checked="SubNav_Checked" />
                        <RadioButton x:Name="SubNavSecond" Style="{StaticResource SegmentButton}" Checked="SubNav_Checked" Margin="3,0,0,0" />
                    </UniformGrid>
                </Border>

                <!-- ================ 0: GENEL ================ -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Genel" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Uygulamanın temel davranışı ve metin işleme katmanları." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutostartToggle" Style="{StaticResource Toggle}"
                                      Content="Windows açılışında otomatik başlat" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Kayıt defterindeki HKCU\Software\Microsoft\Windows\CurrentVersion\Run anahtarını kullanır; yönetici hakkı gerektirmez." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Dikte dili" />
                            <ComboBox x:Name="LanguageCombo" Width="240" AutomationProperties.Name="Dikte dili" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Whisper'a verilen dil kodu. Yanlış dil doğruluğu belirgin biçimde düşürür." />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <CheckBox x:Name="chkLanguageFastSwitch" Style="{StaticResource Toggle}" IsChecked="False"
                                      Content="Hızlı Dil Değiştirme Kısayolunu Etkinleştir" />
                            <TextBlock x:Name="LanguageFastSwitchHint" Style="{StaticResource FieldHint}"
                                       Text="Dikte sırasında veya masaüstündeyken Alt+L kısayolu ile seçtiğiniz diller arasında sırayla geçiş yapın." />

                            <!-- Geçiş yapılacak diller (açılır bölüm). Anahtar kapalıyken soluk. -->
                            <StackPanel Margin="0,8,0,0"
                                        IsEnabled="{Binding IsChecked, ElementName=chkLanguageFastSwitch}">
                                <ToggleButton x:Name="FastSwitchLanguagesExpander" Style="{StaticResource DisclosureButton}"
                                              AutomationProperties.Name="Geçiş yapılacak dilleri göster veya gizle">
                                    <TextBlock x:Name="FastSwitchLanguagesSummary" Text="Geçiş yapılacak diller: Türkçe, İngilizce"
                                               TextTrimming="CharacterEllipsis" />
                                </ToggleButton>
                                <StackPanel Margin="24,8,0,0"
                                            Visibility="{Binding IsChecked, ElementName=FastSwitchLanguagesExpander, Converter={StaticResource BoolToVisibility}}">
                                    <WrapPanel x:Name="FastSwitchLanguagesPanel" />

                                    <!-- Geçiş sırası: ‹ › oklarıyla (klavyeyle de kullanılabilir). -->
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Geçiş sırası" Margin="0,4,0,8" />
                                    <ItemsControl x:Name="FastSwitchOrderList" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E22" BorderBrush="#35353C" BorderThickness="1.2"
                                                        CornerRadius="6" Height="32" Padding="4,0" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactGhostButton}" Width="24" Height="24" Padding="0"
                                                                Tag="{Binding Code}" IsEnabled="{Binding CanMoveEarlier}"
                                                                Click="FastSwitchMoveEarlier_Click" Cursor="Hand"
                                                                AutomationProperties.Name="{Binding MoveEarlierName}" ToolTip="Öne al">
                                                            <Path Style="{StaticResource LineIcon}" Data="M15 6l-6 6 6 6"
                                                                  Stroke="{StaticResource TextPrimary}" Width="10" Height="10" />
                                                        </Button>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}"
                                                                   FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0" />
                                                        <Button Style="{StaticResource CompactGhostButton}" Width="24" Height="24" Padding="0"
                                                                Tag="{Binding Code}" IsEnabled="{Binding CanMoveLater}"
                                                                Click="FastSwitchMoveLater_Click" Cursor="Hand"
                                                                AutomationProperties.Name="{Binding MoveLaterName}" ToolTip="Sona doğru al">
                                                            <Path Style="{StaticResource LineIcon}" Data="M9 6l6 6-6 6"
                                                                  Stroke="{StaticResource TextPrimary}" Width="10" Height="10" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,0"
                                               Text="Kısayola her basışta bu sırayla ilerlenir; sondan sonra başa dönülür. Sıralamak için dillerin yanındaki okları kullanın. Yeni seçilen dil sona eklenir; en az iki dil seçili olmalı." />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="NormalizationToggle" Style="{StaticResource Toggle}"
                                      Content="Sayı, tarih ve birim normalizasyonu" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="&quot;yüzde yirmi&quot; → &quot;%20&quot;, &quot;on beş eylül&quot; → &quot;15 Eylül&quot;, &quot;üç buçuk kilo&quot; → &quot;3,5 kg&quot;" />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <CheckBox x:Name="DictionaryToggle" Style="{StaticResource Toggle}"
                                      Content="Özel sözlük (teknik terim düzeltme)" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="&quot;pitonda&quot; → &quot;Python'da&quot;. Kuralları Sözlük sekmesinden düzenleyebilirsiniz." />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <CheckBox x:Name="chkSpokenPunctuation" Style="{StaticResource Toggle}"
                                      Content="Sesli Noktalama Komutları" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Dikte sırasında 'nokta', 'virgül', 'yeni satır' gibi komutları noktalama işaretlerine çevirir" />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <CheckBox x:Name="StreamingPreviewToggle" Style="{StaticResource Toggle}"
                                      Content="Canlı akış (real-time live preview) transkripsiyonu" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Kayıt devam ederken ekrandaki kapsülde kelimelerin canlı olarak akmasını sağlar. Kayıt bitince nihai metin hedefe yapıştırılır." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Görünüm" />
                            <CheckBox x:Name="MicaToggle" Style="{StaticResource Toggle}" IsChecked="False"
                                      Content="Windows 11 Mica / Saydamlık Efektini Etkinleştir"
                                      Checked="MicaToggle_Changed" Unchecked="MicaToggle_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Windows 11'in modern DWM arka plan dokusunu uygular (Yalnızca Windows 11 destekler)." />
                            <TextBlock x:Name="MicaPendingHint" Style="{StaticResource FieldHint}" Visibility="Collapsed"
                                       Foreground="#FBBF24" Text="" />
                        </StackPanel>
                    </Border>

                    <!-- Güncellemeler: GitHub Releases'taki son sürümle karşılaştırır. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Güncellemeler" />
                            <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle}" IsChecked="False"
                                      Content="Açılışta yeni sürümleri otomatik denetle" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Uygulama açıldıktan 10 saniye sonra GitHub'da bir kez denetler; yeni sürüm varsa tepsi menüsünde gösterilir." />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtUpdateStatus" Grid.Column="0" Text="Mevcut sürüm: v2.1.0"
                                           Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button x:Name="btnCheckUpdates" Grid.Column="1" Style="{StaticResource GhostButton}"
                                        Content="Şimdi Denetle" Width="120" Height="32" Click="CheckUpdates_Click" />
                            </Grid>

                            <Border x:Name="borderUpdateAvailable" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="#0F2418" BorderBrush="{StaticResource Success}" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSparkle}"
                                              Stroke="{StaticResource Success}" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock x:Name="txtUpdateTitle" Text="" Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock x:Name="txtUpdateNotes" Text="" Foreground="{StaticResource TextMuted}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Sürüm Notlarını ve İndirmeyi Aç"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenReleasePage_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================ 1: SES ================ -->
                <StackPanel x:Name="PageAudio" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ses" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Dikte için kullanılacak mikrofonu seçin." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mikrofon" />
                            <ComboBox x:Name="MicrophoneCombo" Width="360" AutomationProperties.Name="Mikrofon" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Seçilen cihaz bilgisayardan çıkarılırsa TRWhisper sessizce sistem varsayılanına döner." />

                            <Button x:Name="RefreshMicsButton" Style="{StaticResource GhostButton}"
                                    Content="Cihazları yenile" HorizontalAlignment="Left"
                                    Width="140" Height="32" Margin="0,10,0,0" Click="RefreshMics_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sesli Geri Bildirim" />
                            <CheckBox x:Name="chkSoundFeedback" Style="{StaticResource Toggle}" IsChecked="False"
                                      Content="Ses efektlerini etkinleştir" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Dikte başladığında ve bittiğinde hafif bir ses çalar." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ses düzeyi" Margin="0,10,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="sliderSoundVolume" Style="{StaticResource ThemedSlider}" Width="260" Minimum="0" Maximum="100" Value="50"
                                        SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" AutomationProperties.Name="Sesli geri bildirim düzeyi"
                                        ValueChanged="SoundVolume_ValueChanged" />
                                <TextBlock x:Name="txtSoundVolumePercent" Text="%50" Width="48" Margin="12,0,0,0"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button x:Name="btnTestSound" Style="{StaticResource GhostButton}"
                                    Content="Sesi Test Et" HorizontalAlignment="Left"
                                    Width="120" Height="32" Margin="0,10,0,0" Click="TestSound_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================ 2: MODEL ================ -->
                <StackPanel x:Name="PageModel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Model" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Whisper modeli ve bellek davranışı." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Whisper modeli" />
                            <ComboBox x:Name="ModelCombo" Width="340" AutomationProperties.Name="Whisper modeli" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Large-v3 Turbo belirgin biçimde daha doğrudur; GPU olmadan yavaş kalır." />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Donanım hızlandırma" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border x:Name="GpuBadge" CornerRadius="11" Height="26" Padding="12,0"
                                        Background="#16301F" BorderBrush="{StaticResource Success}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="GpuDot" Width="8" Height="8" Fill="{StaticResource Success}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="GpuBadgeText" Text="CUDA etkin"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="GpuHint" Style="{StaticResource FieldHint}" Text="" />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Canlı bellek ve model durumu" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border x:Name="ModelStatusBadge" CornerRadius="11" Height="26" Padding="12,0"
                                        Background="#1D1D20" BorderBrush="#71717A" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="ModelStatusDot" Width="8" Height="8" Fill="#71717A"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="ModelStatusText" Text="Model Boşta (İlk diktede otomatik yüklenecek)"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtMemoryUsage" Style="{StaticResource FieldHint}" Text="" />
                            <Button x:Name="btnUnloadModel" Style="{StaticResource CompactGhostButton}"
                                    Content="Modeli Bellekten Boşalt" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    IsEnabled="False" Click="UnloadModel_Click" />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Bellek/VRAM boşaltma süresi" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBox x:Name="IdleMinutesBox" Width="64" Height="32"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         TextAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                         AutomationProperties.Name="Bellek bosaltma suresi (dakika)"
                                         PreviewTextInput="NumericOnly_PreviewTextInput" />
                                <TextBlock Text="dakika" Foreground="{StaticResource TextMuted}" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Model bu süre boyunca kullanılmazsa bellekten atılır. 0 yazarsanız hiç boşaltılmaz: VRAM dolu kalır ama her dikte sıcak başlar." />
                        </StackPanel>
                    </Border>

                    <!-- Model Kütüphanesi ve İndirme Kartı -->
                    <Border Style="{StaticResource Card}" Padding="16,12,16,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="15" Text="Model Kütüphanesi ve İndirme" />
                            <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8"
                                       Text="Whisper modellerini doğrudan buradan indirebilir veya disk alanı boşaltmak için silebilirsiniz." />

                            <!-- İndirme İlerleme Alanı (Canlı İndirme Sırasında Görünür) -->
                            <Border x:Name="DownloadProgressCard" Background="#1A1A22" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="DownloadingModelTitle" Text="Model İndiriliyor..." Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                                        <Button x:Name="CancelDownloadButton" Style="{StaticResource CompactGhostButton}"
                                                Content="İptal" Width="56" Height="26" HorizontalAlignment="Right" Click="CancelDownload_Click" ToolTip="İndirmeyi İptal Et" />
                                    </Grid>
                                    <ProgressBar x:Name="ModelDownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="{StaticResource Accent}" Background="#2A2A35" BorderThickness="0" Margin="0,0,0,8" />
                                    <Grid>
                                        <TextBlock x:Name="DownloadDetailText" Text="0 MB / 0 MB (%0)" Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                                        <TextBlock x:Name="DownloadSpeedText" Text="0 MB/s" Foreground="#A1A1AA" FontSize="11.5" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Model Listesi -->
                            <ItemsControl x:Name="ModelsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Sol: Model Bilgisi -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" />
                                                        <!-- Aktif / Kurulu Rozeti -->
                                                        <Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1"
                                                                CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="Medium" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Sağ: Aksiyon Butonları (Sabit hizalı 2 sütunlu grid) -->
                                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Kolon 0: Seç Aksiyonu -->
                                                    <Button Grid.Column="0" Content="Seç" Style="{StaticResource CompactGhostButton}" Width="56" Height="26"
                                                            Tag="{Binding}" Click="SelectModel_Click" Visibility="{Binding SelectButtonVisibility}" ToolTip="Bu modeli aktif Whisper modeli yap" />

                                                    <!-- Kolon 2: İndir veya Sil Aksiyonu (Sil tuşu ile aynı hizada) -->
                                                    <Button Grid.Column="2" Content="İndir" Style="{StaticResource CompactPrimaryButton}" Width="56" Height="26"
                                                            Tag="{Binding}" Click="DownloadModel_Click" Visibility="{Binding DownloadButtonVisibility}" ToolTip="Modeli internetten indir" />

                                                    <Button Grid.Column="2" Content="Sil" Style="{StaticResource DangerIconButton}" Width="56" Height="26"
                                                            Tag="{Binding}" Click="DeleteModel_Click" Visibility="{Binding DeleteButtonVisibility}" ToolTip="Bu modeli diskten silerek alan boşalt" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================ 3: KISAYOL ================ -->
                <StackPanel x:Name="PageHotkey" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Kısayol" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Bas-konuş tuşunu basılı tutun, konuşun, bırakın. İstediğiniz herhangi bir tuşu veya tuş kombinasyonunu atayabilirsiniz." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Çalışma biçimi" />
                            <ComboBox x:Name="DictationModeCombo" Width="330" AutomationProperties.Name="Calisma bicimi" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DictationModeHint" Style="{StaticResource FieldHint}" Text="" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="HandsFreeCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sessizlikte otomatik bitirme" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SilenceMsBox" Width="110" AutomationProperties.Name="Sessizlik suresi (ms)" PreviewTextInput="NumericOnly_PreviewTextInput" />
                                <TextBlock Text="ms sessizlik" Foreground="{StaticResource TextMuted}" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,24,0" />
                                <TextBox x:Name="SilenceThresholdBox" Width="110" AutomationProperties.Name="Ses esigi" />
                                <TextBlock Text="ses eşiği (0-1)" Foreground="{StaticResource TextMuted}" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Konuşma başladıktan sonra bu süre boyunca kesintisiz sessizlik olursa kayıt kendiliğinden biter. Eşik mikrofon duyarlılığına göre değişir: cümle aralarında erken kesiyorsa düşürün, ortam gürültüsünde hiç bitmiyorsa yükseltin." />
                        </StackPanel>
                    </Border>

                    <!-- Bas-Konuş Tuşu Kartı -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Bas-konuş tuşu veya kombinasyonu" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- Seçili Kısayol Göstergesi -->
                                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource StrokeStrong}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,0" Width="260" Height="32">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconKeyboard}"
                                                  Stroke="{StaticResource TextMuted}" Width="15" Height="15" Margin="0,0,9,0" />
                                        <TextBlock x:Name="PttKeyDisplayText" Text="Sağ Ctrl" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Kısayol Ata Butonu -->
                                <Button x:Name="RecordPttButton" Style="{StaticResource PrimaryButton}"
                                        Content="Kısayol Ata" Width="120" Height="32" Margin="10,0,0,0"
                                        Click="RecordPttButton_Click" ToolTip="Tıklayın ve klavyeden istediğiniz tuşa veya tuş kombinasyonuna basın" />
                            </StackPanel>

                            <!-- Kayıt Bilgilendirme Banner'ı (Kayıt sırasındayken görünür) -->
                            <Border x:Name="PttRecordingBanner" Background="#261E14" BorderBrush="#EAB308" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="#FACC15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="Klavyeden herhangi bir tuşa veya kombinasyona basın (örn: Ctrl+Space, F8)... İptal için Esc."
                                               Foreground="#FACC15" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Hızlı Seçenekler -->
                            <TextBlock Text="Hızlı seçim:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="Sağ Ctrl" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="RightCtrl" Click="PresetPtt_Click" />
                                <Button Content="Sol Ctrl" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="LeftCtrl" Click="PresetPtt_Click" />
                                <Button Content="Caps Lock" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="CapsLock" Click="PresetPtt_Click" />
                                <Button Content="F8" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="F8" Click="PresetPtt_Click" />
                                <Button Content="F9" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="F9" Click="PresetPtt_Click" />
                                <Button Content="Mouse 4 (Geri)" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Mouse4" Click="PresetPtt_Click" />
                                <Button Content="Mouse 5 (İleri)" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Mouse5" Click="PresetPtt_Click" />
                                <Button Content="Ctrl + Space" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Ctrl+Space" Click="PresetPtt_Click" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                       Text="Tek bir tuş (F8, CapsLock vb.) veya kombinasyon (Ctrl+Boşluk, Alt+D vb.) kullanabilirsiniz." />
                        </StackPanel>
                    </Border>

                    <!-- LLM Temizleme Tuşu Kartı -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="LLM temizleme tuşu veya kombinasyonu" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- Seçili Kısayol Göstergesi -->
                                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource StrokeStrong}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,0" Width="260" Height="32">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource IconSparkle}"
                                                  Fill="#A78BFA" Margin="0,0,9,0" />
                                        <TextBlock x:Name="LlmKeyDisplayText" Text="Shift" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Kısayol Ata Butonu -->
                                <Button x:Name="RecordLlmButton" Style="{StaticResource PrimaryButton}"
                                        Content="Kısayol Ata" Width="120" Height="32" Margin="10,0,0,0"
                                        Click="RecordLlmButton_Click" ToolTip="Tıklayın ve klavyeden istediğiniz tuşa veya tuş kombinasyonuna basın" />

                                <!-- Kullanma (Devre Dışı) Butonu -->
                                <Button x:Name="DisableLlmButton" Style="{StaticResource GhostButton}"
                                        Content="Kullanma" Width="100" Height="32" Margin="8,0,0,0"
                                        Click="DisableLlmButton_Click" ToolTip="LLM temizleme tuşunu devre dışı bırak" />
                            </StackPanel>

                            <!-- Kayıt Bilgilendirme Banner'ı -->
                            <Border x:Name="LlmRecordingBanner" Background="#261E14" BorderBrush="#EAB308" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="#FACC15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="Klavyeden herhangi bir tuşa basın (örn: Shift, Ctrl, Alt, F9)... İptal için Esc."
                                               Foreground="#FACC15" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Hızlı Seçenekler -->
                            <TextBlock Text="Hızlı seçim:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="Shift (Varsayılan)" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Shift" Click="PresetLlm_Click" />
                                <Button Content="Ctrl" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Ctrl" Click="PresetLlm_Click" />
                                <Button Content="Alt" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Alt" Click="PresetLlm_Click" />
                                <Button Content="Sağ Shift" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="RightShift" Click="PresetLlm_Click" />
                                <Button Content="Kullanma (Yok)" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="None" Click="PresetLlm_Click" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                       Text="Bas-konuş sırasında bu tuş da basılıysa metin yapay zekâ ile temizlenir. 'Kullanma' seçeneğiyle tamamen kapatabilirsiniz." />
                        </StackPanel>
                    </Border>

                    <!-- Hızlı Dil Geçişi Kısayolu Kartı -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Hızlı dil geçişi kısayolu" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- Seçili Kısayol Göstergesi -->
                                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource StrokeStrong}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,0" Width="260" Height="32">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconGlobe}"
                                                  Stroke="{StaticResource TextMuted}" Width="15" Height="15" Margin="0,0,9,0" />
                                        <TextBlock x:Name="LangKeyDisplayText" Text="Alt + L" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Kısayol Ata Butonu -->
                                <Button x:Name="RecordLangButton" Style="{StaticResource PrimaryButton}"
                                        Content="Kısayol Ata" Width="120" Height="32" Margin="10,0,0,0"
                                        Click="RecordLangButton_Click" ToolTip="Tıklayın ve klavyeden bir tuş kombinasyonuna basın" />
                            </StackPanel>

                            <!-- Kayıt Bilgilendirme Banner'ı -->
                            <Border x:Name="LangRecordingBanner" Background="#261E14" BorderBrush="#EAB308" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="#FACC15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="Bir tuş kombinasyonuna basın (örn: Alt+L, Ctrl+Alt+L, F7)... İptal için Esc."
                                               Foreground="#FACC15" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Hızlı Seçenekler -->
                            <TextBlock Text="Hızlı seçim:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,2">
                                <Button Content="Alt + L (Varsayılan)" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Alt+L" Click="PresetLang_Click" />
                                <Button Content="Ctrl + Alt + L" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Ctrl+Alt+L" Click="PresetLang_Click" />
                                <Button Content="Ctrl + Shift + L" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="Ctrl+Shift+L" Click="PresetLang_Click" />
                                <Button Content="F7" Style="{StaticResource PresetChipButton}" Margin="0,0,6,6" Tag="F7" Click="PresetLang_Click" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                       Text="Yalnızca Genel sekmesinde 'Hızlı Dil Değiştirme' açıkken çalışır. Ctrl, Alt veya Win içeren bir kombinasyon ya da tek başına bir F tuşu seçin; yazmayı bozacağı için tek harf, Shift+harf, fare tuşu ve bas-konuş tuşu kabul edilmez." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================ 4: SÖZLÜK ================ -->
                <StackPanel x:Name="PageDictionary" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Özel Sözlük" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Whisper'ın yanlış yazdığı terimleri düzeltin. Değişiklikler anında dictionary.json'a yazılır ve bir sonraki diktede geçerli olur." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Yeni kural" />
                            <!-- Kutular sabit genişlik yerine alanı paylaşır: dar pencerede satır karttan taşmaz. -->
                            <Grid MaxWidth="600" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewMatchBox" Grid.Column="0" KeyDown="NewRuleBox_KeyDown"
                                         AutomationProperties.Name="Duyulan hali" />
                                <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextMuted}"
                                           FontSize="15" VerticalAlignment="Center" Margin="12,0" />
                                <TextBox x:Name="NewReplaceBox" Grid.Column="2" KeyDown="NewRuleBox_KeyDown"
                                         AutomationProperties.Name="Yazilacak hali" />
                                <Button x:Name="AddRuleButton" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                                        Content="Ekle" Width="80" Height="32" Margin="12,0,0,0" Click="AddRule_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                                       Text="Soldaki alana Whisper'ın duyduğu hâli (&quot;piton&quot;), sağdakine doğru yazımı (&quot;Python&quot;) yazın." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,8,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DUYULAN" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="YAZILAN" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="SemiBold" />
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Stroke}" />

                            <ListBox x:Name="RulesList" Background="Transparent" BorderThickness="0"
                                     MaxHeight="288" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="Transparent" Padding="18,0">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#1C1C20" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Match}" Foreground="#C9C9D1"
                                                       FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Replace}" Foreground="#F4F4F5"
                                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Style="{StaticResource DangerIconButton}"
                                                    Content="Sil" FontSize="11" Width="52" Height="26"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="DeleteRule_Click"
                                                    ToolTip="Bu kuralı sil" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="RuleCountText" Style="{StaticResource FieldHint}" Margin="4,4,0,0" Text="" />
                </StackPanel>

                <!-- ================ 5: YAPAY ZEKA ================ -->
                <StackPanel x:Name="PageAi" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Yapay Zeka" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Dikte metnini bir dil modeliyle temizleyin: dolgu kelimeleri atılır, noktalama düzeltilir." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="LlmEnabledToggle" Style="{StaticResource Toggle}"
                                      Content="LLM temizlemeyi varsayılan olarak aç" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Kapalıyken de Kısayol sekmesindeki LLM tuşuyla tek seferlik kullanabilirsiniz." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sağlayıcı" />
                            <ComboBox x:Name="LlmProviderCombo" Width="340" AutomationProperties.Name="LLM saglayicisi" HorizontalAlignment="Left" SelectionChanged="LlmProviderCombo_SelectionChanged" />

                            <!-- Gizlilik Rozetleri (Hizalı ve kompakt) -->
                            <!-- 1. Ollama (Çevrimdışı Yeşil Rozet) -->
                            <Border x:Name="OllamaOfflineBadge" Background="#14261C" BorderBrush="#22C55E" BorderThickness="1"
                                    CornerRadius="8" Padding="12,7" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconLock}"
                                               Stroke="#4ADE80" Width="14" Height="14" Margin="0,0,9,0" />
                                    <TextBlock Text="%100 Çevrimdışı: Veriler bilgisayarınızdan dışarı çıkmaz"
                                               Foreground="#4ADE80" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Bulut (Uyarı Sarı Rozet) -->
                            <Border x:Name="CloudWarningBadge" Background="#262114" BorderBrush="#EAB308" BorderThickness="1"
                                    CornerRadius="8" Padding="12,7" Margin="0,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWarning}"
                                               Stroke="#FACC15" Width="14" Height="14" Margin="0,0,9,0" />
                                    <TextBlock Text="Metin bulut sağlayıcısına iletilir (ses iletilmez)"
                                               Foreground="#FACC15" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="API adresi" Margin="0,10,0,6" />
                            <TextBox x:Name="LlmEndpointBox" Width="460" AutomationProperties.Name="API adresi" HorizontalAlignment="Left" TextChanged="LlmEndpointBox_TextChanged" />
                            <TextBlock x:Name="LlmEndpointHint" Style="{StaticResource FieldHint}"
                                       Text="Ollama için varsayılan: http://localhost:11434/v1/chat/completions" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Model adı" Margin="0,10,0,6" />
                            <TextBox x:Name="LlmModelBox" Width="340" AutomationProperties.Name="LLM model adi" HorizontalAlignment="Left" />
                            <TextBlock x:Name="LlmModelHint" Style="{StaticResource FieldHint}"
                                       Text="Önerilen yerel modeller: qwen2.5:3b, llama3.2:3b, gemma2:2b" />

                            <!-- API Anahtarı alanı (Ollama için gizlenebilir) -->
                            <StackPanel x:Name="LlmApiKeyPanel" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="API anahtarı" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <!-- Ayni kutuda iki denetim: maskeli (varsayilan) ve acik metin. -->
                                    <Grid Width="460">
                                        <PasswordBox x:Name="LlmApiKeyPasswordBox"
                                                     AutomationProperties.Name="API anahtari" />
                                        <TextBox x:Name="LlmApiKeyBox" Visibility="Collapsed"
                                                 AutomationProperties.Name="API anahtari (acik metin)" />
                                    </Grid>
                                    <Button x:Name="ApiKeyRevealButton" Style="{StaticResource GhostButton}"
                                            Width="46" Height="32" Padding="0" Margin="8,0,0,0"
                                            Click="ApiKeyReveal_Click"
                                            AutomationProperties.Name="API anahtarini goster"
                                            ToolTip="API anahtarını göster">
                                        <Path x:Name="ApiKeyRevealIcon" Style="{StaticResource LineIcon}"
                                              Data="{StaticResource IconEye}" Stroke="{StaticResource TextPrimary}"
                                              Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Anahtar Windows DPAPI ile şifrelenerek güvenle saklanır." />

                                <!-- Anahtar yaşam döngüsü: yaş, rotasyon hatırlatması, silme -->
                                <Grid Margin="0,8,0,0" Width="514" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="Anahtar yaşı: " Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ApiKeyAgeText" Text="—" Foreground="{StaticResource Accent}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="ClearApiKeyButton" Style="{StaticResource DangerIconButton}"
                                            Width="128" Height="32" HorizontalAlignment="Right"
                                            Click="ClearApiKey_Click"
                                            AutomationProperties.Name="API anahtarini sil"
                                            ToolTip="Anahtarı bu bilgisayardan siler. Sağlayıcı panelinden de iptal etmeniz önerilir.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconTrash}"
                                                  Stroke="{StaticResource Danger}" Width="14" Height="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Anahtarı Sil" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border x:Name="ApiKeyRotationBadge" Background="#262114" BorderBrush="#EAB308"
                                        BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWarning}"
                                              Stroke="#FACC15" Width="14" Height="14" Margin="0,0,9,0" />
                                        <TextBlock x:Name="ApiKeyRotationText" Foreground="#FACC15" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   MaxWidth="470" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,8,0,0" Width="514" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="Rotasyon hatırlatması" Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox x:Name="KeyRotationDaysBox" Width="64" Height="32"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 TextAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                                 AutomationProperties.Name="Rotasyon hatirlatma gun sayisi"
                                                 PreviewTextInput="NumericOnly_PreviewTextInput" />
                                        <TextBlock Text="gün (0 = kapalı)" Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <Button x:Name="OpenProviderConsoleButton" Style="{StaticResource GhostButton}"
                                            MinWidth="176" Height="32" HorizontalAlignment="Right"
                                            Click="OpenProviderConsole_Click"
                                            ToolTip="Sağlayıcının anahtar yönetim sayfasını açar: anahtarı kısıtlayabilir, döndürebilir veya iptal edebilirsiniz.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconLock}"
                                                  Stroke="{StaticResource TextPrimary}" Width="14" Height="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Anahtar Panelini Aç" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" MaxWidth="514"
                                           HorizontalAlignment="Left"
                                           Text="TRWhisper anahtarı yalnızca saklar; kapsamını daraltmak (model/IP kısıtı), süresini yönetmek ve iptal etmek sağlayıcı panelinden yapılır. Anahtarı düzenli aralıklarla yenilemek, sızma hâlinde zararı sınırlar." />
                            </StackPanel>

                            <!-- Bağlantıyı Test Et Butonu ve Durum Mesajı -->
                            <StackPanel Margin="0,10,0,0">
                                <Button x:Name="TestLlmConnectionButton" Style="{StaticResource GhostButton}"
                                        Click="TestLlmConnection_Click" MinWidth="160" Height="32"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource IconBolt}"
                                              Fill="#FACC15" Margin="0,0,8,0" />
                                        <TextBlock Text="Bağlantıyı Test Et" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="LlmConnectionStatusText" Style="{StaticResource FieldHint}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Kullanım ve maliyet tavanı (yalnızca bulut sağlayıcılarda) -->
                    <Border x:Name="QuotaCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="15" Text="Kullanım ve Maliyet Tavanı" />
                            <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Text="Bulut sağlayıcı seçiliyken LLM temizlemeli her dikte bir API çağrısı doğurur. Günlük tavan, beklenmedik faturaya karşı uygulamanın kendi içindeki durdurucusudur." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Günlük çağrı tavanı" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBox x:Name="DailyLimitBox" Width="80" Height="32"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         TextAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                         AutomationProperties.Name="Gunluk cagri tavani"
                                         PreviewTextInput="NumericOnly_PreviewTextInput" />
                                <TextBlock Text="çağrı/gün (0 = sınırsız)" Foreground="{StaticResource TextMuted}"
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tavan dolduğunda" Margin="0,10,0,6" />
                            <ComboBox x:Name="QuotaActionCombo" Width="340" HorizontalAlignment="Left"
                                      AutomationProperties.Name="Tavan dolunca yapilacak"
                                      SelectionChanged="QuotaActionCombo_SelectionChanged" />
                            <TextBlock x:Name="QuotaActionHint" Style="{StaticResource FieldHint}" TextWrapping="Wrap" MaxWidth="514"
                                       HorizontalAlignment="Left"
                                       Text="Engelle: tavan dolunca LLM temizleme atlanır, ham transkript yazılır; ek ücret doğmaz." />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <Grid Width="514" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="Bugünkü kullanım: " Foreground="{StaticResource TextMuted}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:Name="QuotaUsageText" Text="—" Foreground="{StaticResource Accent}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="ResetUsageButton" Style="{StaticResource GhostButton}"
                                        MinWidth="150" Height="32" HorizontalAlignment="Right"
                                        Click="ResetUsage_Click"
                                        ToolTip="Bugünkü sayacı sıfırlar. Sağlayıcıdaki gerçek kullanımı değiştirmez.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconReset}"
                                              Stroke="{StaticResource TextPrimary}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Sayacı Sıfırla" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LLM Modları ve Akıllı Şablonlar -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="15" Text="LLM Modları ve Akıllı Şablonlar" />
                            <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8"
                                       Text="Dikte bağlamınıza uygun şablonu seçin veya kendi özel komut isteminizi tanımlayın." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Aktif Mod" Margin="0,0,0,6" />
                            <ComboBox x:Name="LlmModeCombo" Width="340" AutomationProperties.Name="Aktif LLM modu" HorizontalAlignment="Left" SelectionChanged="LlmModeCombo_SelectionChanged" />
                            <TextBlock x:Name="LlmModeDescriptionText" Style="{StaticResource FieldHint}" Margin="0,6,0,8"
                                       Text="Konuşma dilini temizler, imlayı düzeltir, aslına sadık kalır." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sistem İstemi (Prompt)" Margin="0,0,0,6" />
                            <TextBox x:Name="LlmModePromptBox" AutomationProperties.Name="Sistem istemi" Height="110" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="12.5" Padding="8" />

                            <Grid Margin="0,10,0,0">
                                <Button x:Name="ResetModePromptButton" Style="{StaticResource GhostButton}"
                                        Content="Varsayılan İsteme Sıfırla" Click="ResetModePrompt_Click"
                                        MinWidth="180" Height="32" HorizontalAlignment="Left" />
                                <Button x:Name="DeleteCustomModeButton" Style="{StaticResource DangerIconButton}"
                                        Content="Modu Sil" Click="DeleteCustomMode_Click"
                                        Width="84" Height="32" HorizontalAlignment="Right" Visibility="Collapsed" />
                            </Grid>

                            <!-- Yeni Özel Mod Ekle Paneli -->
                            <Border Background="#1A1A1E" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPlus}"
                                              Stroke="{StaticResource TextPrimary}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Yeni Özel Mod Ekle" Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="İkon" HorizontalAlignment="Center" />
                                            <TextBox x:Name="NewModeIconBox" Text="🎯" MaxLength="4"
                                                     Width="54" Height="32"
                                                     FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                     FontSize="18" Padding="0"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     TextAlignment="Center">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="8">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                                      Margin="0"
                                                                                      Focusable="False"
                                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                                      VerticalScrollBarVisibility="Hidden"
                                                                                      VerticalAlignment="Center"
                                                                                      MinHeight="28" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#5A5A64" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Opacity" Value="0.45" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mod Adı" />
                                            <TextBox x:Name="NewModeNameBox" Height="32" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Açıklama" />
                                    <TextBox x:Name="NewModeDescBox" Margin="0,0,0,10" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sistem İstemi" />
                                    <TextBox x:Name="NewModePromptBox" Height="74" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="12" Padding="6" Margin="0,0,0,10" />
                                    <Button x:Name="AddNewModeButton" Style="{StaticResource PrimaryButton}"
                                            Content="Özel Modu Ekle" HorizontalAlignment="Right" MinWidth="130" Height="32"
                                            Click="AddNewMode_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Uygulamaya Göre Otomatik Mod (Auto App Mode) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoAppModeToggle" Style="{StaticResource Toggle}"
                                      Content="Uygulamaya Göre Otomatik Mod (Bağlam Duyarlı)"
                                      Checked="AutoAppModeToggle_Changed" Unchecked="AutoAppModeToggle_Changed" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,8"
                                       Text="Ön plandaki pencerenin uygulama adını (Outlook, VS Code, Slack vb.) tespit ederek uygun LLM modunu otomatik seçer." />

                            <StackPanel x:Name="AutoAppModePanel">
                                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,10" />

                                <TextBlock Style="{StaticResource SectionTitle}" FontSize="14" Text="Uygulama - LLM Modu Eşlemeleri" />
                                <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8"
                                           Text="Hangi uygulamanın hangi modla açılacağını belirleyin. Eşleşmeyen uygulamalarda genel aktif mod kullanılır." />

                                <!-- Yeni Eşleme Ekleme Formu -->
                                <Border Background="#1A1A1E" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Süreç / Uygulama Adı" FontSize="11.5" />
                                            <TextBox x:Name="NewAppProcessBox" ToolTip="Örn: notepad, thunderbird, chrome, WindowsTerminal" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextMuted}"
                                                   FontSize="16" VerticalAlignment="Bottom" Margin="12,0,12,8" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Kullanılacak Mod" FontSize="11.5" />
                                            <ComboBox x:Name="NewAppModeCombo" />
                                        </StackPanel>
                                        <Button x:Name="AddAppMappingButton" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                                                Content="Eşle" MinWidth="74" Height="32" VerticalAlignment="Bottom"
                                                Margin="12,0,0,0" Click="AddAppMapping_Click" />
                                    </Grid>
                                </Border>

                                <!-- Eşleme Listesi -->
                                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        CornerRadius="8" Padding="0">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="12,8,12,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="UYGULAMA (PROCESS)" Foreground="{StaticResource TextMuted}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="LLM MODU" Foreground="{StaticResource TextMuted}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Stroke}" />

                                        <ListBox x:Name="AppMappingsList" Background="Transparent" BorderThickness="0"
                                                 MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="bd" Background="Transparent" Padding="16,0">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#222228" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="34">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="#E4E4E7"
                                                                   FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ModeDisplayName}" Foreground="#A1A1AA"
                                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Style="{StaticResource DangerIconButton}"
                                                                Content="Sil" FontSize="11" Width="52" Height="26"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Tag="{Binding}" Click="DeleteAppMapping_Click"
                                                                ToolTip="Bu eşlemeyi kaldır" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================ 6: KAPSÜL ================ -->
                <StackPanel x:Name="PageOverlay" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Kapsül" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Dikte sırasında ekranda beliren küçük göstergenin davranışı ve konumu." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ekrandaki konumu" />
                            <WrapPanel>
                                <ComboBox x:Name="OverlayPositionCombo" Width="200" Margin="0,0,8,6" AutomationProperties.Name="Kapsul konumu" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="OverlayPositionCombo_SelectionChanged" />
                                <Button x:Name="LaunchPositioningButton" Style="{StaticResource PrimaryButton}"
                                        Content="Konumu Ekranda Ayarla" Height="32" VerticalAlignment="Center" Margin="0,0,8,6"
                                        Click="LaunchPositioning_Click" ToolTip="Kapsülü ekranda açar ve fareyle sürükleyip yerleştirmenizi sağlar" />
                                <Button x:Name="ResetPositionButton" Style="{StaticResource GhostButton}"
                                        Height="32" VerticalAlignment="Center" Margin="0,0,0,6"
                                        Click="ResetPosition_Click" ToolTip="Kapsülü ekranın alt ortasındaki varsayılan konumuna döndürür">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconReset}"
                                              Stroke="{StaticResource TextPrimary}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Varsayılana Dön" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Mevcut Konum: " Foreground="{StaticResource TextMuted}" FontSize="11.5" />
                                <TextBlock x:Name="OverlayCustomCoordsText" Text="Varsayılan (Alt Orta)" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Kapsülün ekranda nerede görüneceğini belirleyin veya 'Konumu Ekranda Ayarla' ile doğrudan ekranda sürükleyin." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Manyetik Kenetlenme" />
                            <CheckBox x:Name="EdgeSnappingToggle" Style="{StaticResource Toggle}" IsChecked="False"
                                      Content="Ekran kenarlarına ve ortaya kenetlen" />
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Konum ayarlama modundayken kapsül ekran kenarlarına veya ortaya yaklaştığında otomatik olarak hizalanır." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Sonuç gösterim süresi" Margin="0,0,0,3" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="0"
                                           Text="Dikte bittikten sonra sonuç kapsülünün ekranda kalma süresi." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="OverlayDurationBox" Width="64" Height="32"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         TextAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                         AutomationProperties.Name="Sonuc gosterim suresi (saniye)"
                                         PreviewTextInput="NumericOnly_PreviewTextInput" />
                                <TextBlock Text="saniye" Foreground="{StaticResource TextMuted}" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ================ 7: YEDEKLEME ================ -->
                <StackPanel x:Name="PageBackup" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Yedekleme" />
                    <TextBlock Style="{StaticResource SectionHint}" TextWrapping="Wrap"
                               Text="Dikte günlükleri (.md), özel sözlük ve ayarlar tek bir ZIP dosyasına alınır. Yedek yalnızca seçtiğiniz klasöre yazılır; TRWhisper onu hiçbir sunucuya göndermez." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="AutoBackupToggle" Style="{StaticResource Toggle}"
                                      Content="Açılışta otomatik yedek al" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" HorizontalAlignment="Left"
                                       Text="Son yedeğin üzerinden aşağıdaki kadar gün geçtiyse TRWhisper açılırken arka planda sessizce yedek alır." />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Yedekleme aralığı" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="BackupIntervalBox" Width="64" Height="32"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 TextAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                                 AutomationProperties.Name="Yedekleme araligi (gun)"
                                                 PreviewTextInput="NumericOnly_PreviewTextInput" />
                                        <TextBlock Text="gün" Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Saklanacak yedek sayısı" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="BackupRetentionBox" Width="64" Height="32"
                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 TextAlignment="Center" FontWeight="SemiBold" FontSize="13.5"
                                                 AutomationProperties.Name="Saklanacak yedek sayisi"
                                                 PreviewTextInput="NumericOnly_PreviewTextInput" />
                                        <TextBlock Text="adet (0 = hepsi)" Foreground="{StaticResource TextMuted}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,12,0,8" />

                            <CheckBox x:Name="IncludeTranscriptsToggle" Style="{StaticResource Toggle}"
                                      Content="Dikte günlüklerini (.md) yedeğe dahil et" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" HorizontalAlignment="Left"
                                       Text="Dikte metinleri ZIP'e şifrelenmeden yazılır. Kapatılırsa yedek yalnızca ayarları ve özel sözlüğü içerir. Dikte geçmişi kaydı kapalıysa günlükler yedeğe hiç alınmaz." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Yedek klasörü" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBox x:Name="BackupDirBox" Width="430" Height="32"
                                         VerticalContentAlignment="Center"
                                         TextChanged="BackupDirBox_TextChanged"
                                         AutomationProperties.Name="Yedek klasoru" />
                                <Button x:Name="OpenBackupFolderButton" Style="{StaticResource GhostButton}"
                                         MinWidth="122" Height="32" Margin="8,0,0,0"
                                         Click="OpenBackupFolder_Click"
                                         ToolTip="Yedek klasörünü Dosya Gezgini'nde açar">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFolder}"
                                              Stroke="{StaticResource TextPrimary}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Klasörü Aç" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="%USERPROFILE%, %APPDATA% gibi ortam değişkenleri kullanılabilir." />
                            <StackPanel x:Name="BackupCloudWarning" Orientation="Horizontal" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Visibility="Collapsed">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWarning}"
                                      Stroke="#FACC15" Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Top" />
                                <TextBlock Foreground="#FACC15" FontSize="12" TextWrapping="Wrap" MaxWidth="520"
                                           Text="Bu klasör OneDrive ile eşitleniyor: yedekler, içindeki şifresiz dikte metinleriyle birlikte buluta yüklenir." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" FontSize="15" Text="Yedek Al / Geri Yükle" />
                            <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Text="Geri yükleme, mevcut ayarların ve dikte günlüklerinin üzerine yazar. Bunu yapmadan önce TRWhisper otomatik olarak mevcut durumun yedeğini alır." />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="CreateBackupButton" Style="{StaticResource PrimaryButton}"
                                         MinWidth="168" Height="32" Click="CreateBackupNow_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconArchive}"
                                              Stroke="White" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Şimdi Yedek Al" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestoreBackupButton" Style="{StaticResource GhostButton}"
                                         MinWidth="184" Height="32" Margin="10,0,0,0" Click="RestoreBackup_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconReset}"
                                              Stroke="{StaticResource TextPrimary}" Width="14" Height="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Yedekten Geri Yükle" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="BackupStatusText" Style="{StaticResource FieldHint}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" />

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,10,0,8" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Mevcut yedekler" />
                            <TextBlock x:Name="NoBackupsText" Style="{StaticResource FieldHint}"
                                       Text="Henüz yedek alınmamış." Visibility="Collapsed" />
                            <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="BackupsListControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A1E" BorderBrush="{StaticResource Stroke}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}"
                                                                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource TextMuted}"
                                                                   FontSize="11.5" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                               Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="#141B24" BorderBrush="#2563EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconLock}"
                                  Stroke="#60A5FA" Width="15" Height="15" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#93C5FD" FontSize="12" TextWrapping="Wrap" MaxWidth="540"
                                       Text="API anahtarınız yedeğe yazılmaz. Yedek dosyası başka bir bilgisayara taşınabilir; sır taşımaması için anahtar dışarıda bırakılır. Geri yükleme sonrası anahtarı Yapay Zeka sekmesinden yeniden girin." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================ 8: GEÇMİŞ ================ -->
                <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Dikte Geçmişi" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Geçmiş diktelerinizi arayın, kopyalayın ve kazandığınız zamanı görün." />

                    <!-- Verimlilik özeti: tek satırlık şerit -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="10" Padding="16,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.Resources>
                                <Style x:Key="StatLabel" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                                <Style x:Key="StatValue" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,1,0,0" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Background="Transparent"
                                        ToolTip="Klavyede ~40 kelime/dk yazmak yerine ~150 kelime/dk konuşarak kazanılan tahmini süre.">
                                <TextBlock Style="{StaticResource StatLabel}" Text="Kazanılan zaman" />
                                <TextBlock x:Name="HistoryTimeSavedText" Style="{StaticResource StatValue}" Text="—" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{StaticResource Stroke}" Margin="12,2" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource StatLabel}" Text="Toplam kelime" />
                                <TextBlock x:Name="HistoryWordsText" Style="{StaticResource StatValue}" Text="—" />
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Background="{StaticResource Stroke}" Margin="12,2" />
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource StatLabel}" Text="Toplam kayıt" />
                                <TextBlock x:Name="HistoryCountText" Style="{StaticResource StatValue}" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Arama ve filtre -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="HistorySearchBox" Height="32" Padding="28,0,8,0" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Kayıtlarda ara" TextChanged="HistorySearch_TextChanged" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" IsHitTestVisible="False"
                                  Stroke="{StaticResource TextMuted}" Width="13" Height="13" HorizontalAlignment="Left" Margin="10,0,0,0" />
                            <TextBlock x:Name="HistorySearchPlaceholder" Text="Kayıtlarda ara..." IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMuted}" FontSize="12.5" VerticalAlignment="Center" Margin="30,0,0,0" />
                        </Grid>
                        <ComboBox x:Name="HistoryDateCombo" Grid.Column="1" Width="108" Height="32" Margin="6,0,0,0"
                                  AutomationProperties.Name="Tarih filtresi" SelectionChanged="HistoryDateCombo_SelectionChanged" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0" Margin="6,0,0,0"
                                Click="HistoryRefresh_Click" ToolTip="Günlük dosyalarını yeniden oku"
                                AutomationProperties.Name="Yenile">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconReset}"
                                  Stroke="{StaticResource TextPrimary}" Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0" Margin="6,0,0,0"
                                Click="OpenHistoryFolder_Click" ToolTip="Dikte günlüğü klasörünü Dosya Gezgini'nde aç"
                                AutomationProperties.Name="Klasörü aç">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFolder}"
                                  Stroke="{StaticResource TextPrimary}" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <TextBlock x:Name="HistoryStatusText" Style="{StaticResource FieldHint}" FontSize="12"
                               Margin="2,2,0,6" Visibility="Collapsed" />

                    <!-- Kayıtlar: kendi kaydırıcısıyla sanallaştırılır (binlerce kayıtta da akıcı). -->
                    <ItemsControl x:Name="HistoryListControl" MaxHeight="400"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource TextMuted}"
                                                       FontSize="11.5" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Visibility="{Binding BadgeVisibility}"
                                                    Background="#141B24" BorderBrush="#1E3A8A" BorderThickness="1">
                                                <TextBlock Text="✨ LLM" Foreground="#93C5FD" FontSize="10.5" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource PresetChipButton}" Height="24" Padding="8,0" Margin="0,0,4,0"
                                                        Content="{Binding DetailsToggleText}" Visibility="{Binding DetailsToggleVisibility}"
                                                        Tag="{Binding}" Click="HistoryToggleDetails_Click"
                                                        ToolTip="Metnin tamamını ve varsa LLM öncesi ham metni gösterir" />
                                                <Button Style="{StaticResource PresetChipButton}" Height="24" Padding="8,0"
                                                        Tag="{Binding}" Click="HistoryCopy_Click"
                                                        AutomationProperties.Name="Panoya kopyala" ToolTip="Panoya kopyala">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconCopy}"
                                                              Stroke="#D4D4D8" Width="11" Height="11" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding CopyLabel}" FontSize="11.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Varsayılan en fazla 2 satır; "Ayrıntı" tamamını açar. -->
                                        <TextBlock Text="{Binding Entry.Text}" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="{Binding TextMaxHeight}" Margin="0,5,0,0" />
                                        <Border Visibility="{Binding RawVisibility}" BorderBrush="{StaticResource StrokeStrong}"
                                                BorderThickness="2,0,0,0" Padding="8,1,0,1" Margin="0,6,0,0">
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="Ham: " FontWeight="SemiBold" /><Run Text="{Binding Entry.RawText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- Alt çubuk -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource TextMuted}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Vazgeç"
                            Width="96" Height="36" Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click"
                            ToolTip="Değişiklikleri kaydetmeden kapatır. Sözlük kuralları ve model indirme/silme işlemleri anında uygulandığı için geri alınmaz." />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Kaydet"
                            Width="96" Height="36" IsDefault="True" Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Border>
</Window>
