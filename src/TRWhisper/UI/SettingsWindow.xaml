                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="4,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="chevron" Style="{StaticResource LineIcon}" Data="M9 6l6 6-6 6"
                                      Stroke="{StaticResource TextMuted}" Width="12" Height="12" Margin="0,0,8,0"
                                      RenderTransformOrigin="0.5,0.5">
